{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "case_id",
      "species",
      "image_path"
    ],
    "properties": {
      "case_id": {
        "type": "string",
        "minLength": 1
      },
      "species": {
        "type": "string",
        "minLength": 1
      },
      "image_path": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status",
      "case_id",
      "species",
      "provenance",
      "observations",
      "limitations"
    ],
    "properties": {
      "status": {
        "const": "success"
      },
      "case_id": {
        "type": "string",
        "minLength": 1
      },
      "species": {
        "type": "string",
        "minLength": 1
      },
      "provenance": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "data_origin",
          "skill",
          "version",
          "model_called"
        ],
        "properties": {
          "data_origin": {
            "enum": [
              "synthetic_fixture",
              "dgx_live_inference",
              "dgx_herb_inference"
            ]
          },
          "skill": {
            "const": "plant_vision"
          },
          "version": {
            "const": "0.2.0"
          },
          "model_called": {
            "type": "boolean"
          },
          "model": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "latency_ms": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "eval_count": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "dgx_hardware_used": {
            "type": "boolean"
          },
          "gpu": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        }
      },
      "observations": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_id",
            "phenotype",
            "region",
            "affected_area_fraction",
            "area_basis",
            "model_score"
          ],
          "properties": {
            "observation_id": {
              "type": "string",
              "minLength": 1
            },
            "phenotype": {
              "enum": [
                "colour_amber",
                "colour_dark_brown",
                "colour_pale_yellow",
                "cut_surface_dense",
                "cut_surface_fissure",
                "cut_surface_hollow",
                "cut_surface_powder",
                "insect_damage",
                "leaf_spot",
                "leaf_yellowing",
                "mould_visible",
                "slice_irregular",
                "unknown",
                "wilting"
              ]
            },
            "region": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "bbox_normalized"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox_normalized": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            },
            "affected_area_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "area_basis": {
              "enum": [
                "visible_leaf_area",
                "visible_subject_area"
              ]
            },
            "model_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "image_usable": {
        "type": "boolean"
      }
    }
  }
}
