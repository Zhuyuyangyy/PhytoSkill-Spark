        "audit_id": "audit-agent-001",
        "stage": "pre_registration"
      },
      "expected_call": {
        "skill": "agentshield_audit",
        "mode": "fixture"
      },
      "note": "Specification only: the Runtime middleware intercepts regardless of this call."
    },
    {
      "id": "agent_should_not_skip_audit_by_omission",
