# Copy to .env (already git-ignored) and fill in. Never commit the real file.
# Real environment variables take precedence over anything set here.

# --- required ---------------------------------------------------------------
# Mainland endpoint. The international endpoint is https://api.stepfun.ai/v1.
# "step_plan" is a shorthand for https://api.stepfun.com/step_plan/v1 — the
# subscription channel, whose Credit pool is INDEPENDENT of the pay-as-you-go
# channel. An account that gets HTTP 402 on /v1 may still work on /step_plan/v1.
PHYTO_STEPFUN_BASE_URL=step_plan

# Tool calling is supported by step-3.7-flash, step-3.5-flash and
# step-3.5-flash-2603. Other models may accept `tools` and silently ignore it,
# so always run `python -m harness preflight` before trusting an A/B run.
PHYTO_STEPFUN_MODEL=step-3.7-flash

# Paste the key here, or leave it out and use PHYTO_STEPFUN_API_KEY_FILE instead
# (preferred on a shared remote host, where the environment is readable by
# other processes).
PHYTO_STEPFUN_API_KEY=
# PHYTO_STEPFUN_API_KEY_FILE=~/.config/phyto/stepfun.key

# --- optional: experiment controls ------------------------------------------
# Leaving these unset means the field is not sent at all, so both A/B arms get
# the same provider default and it is not a controlled variable. Whatever is
# actually sent is recorded in the report under sampling_parameters_sent.
# PHYTO_REASONING_EFFORT=low
# PHYTO_TEMPERATURE=
# PHYTO_MAX_TOKENS=
PHYTO_MAX_TURNS=6

# --- optional: transport ----------------------------------------------------
PHYTO_HTTP_TIMEOUT_SECONDS=90
PHYTO_HTTP_MAX_RETRIES=4
# PHYTO_HTTP_PROXY=http://127.0.0.1:7890

# --- optional: preflight ----------------------------------------------------
# 20 requests is the minimum that can reveal load balancing across snapshots.
PHYTO_PREFLIGHT_SAMPLES=20

# "hash" keeps only digests of tool payloads in the trace; "full" stores them.
PHYTO_TRACE_PAYLOAD=hash
