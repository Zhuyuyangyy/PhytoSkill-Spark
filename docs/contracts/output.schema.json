{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phytoskill:phyto-diagnosis:output:0.1.0",
  "title": "PhytoDiagnosis Output 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "vision",
    "environment",
    "knowledge",
    "assessment",
    "recommendations",
    "missing_information",
    "limitations",
    "errors",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "needs_more_info",
        "unsupported",
        "error"
      ],
      "description": "执行状态，不是病原确诊等级。"
    },
    "vision": {
      "anyOf": [
        {
          "$ref": "#/$defs/vision"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "anyOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "type": "null"
        }
      ]
    },
    "knowledge": {
      "anyOf": [
        {
          "$ref": "#/$defs/knowledge"
        },
        {
          "type": "null"
        }
      ]
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/assessment"
        },
        {
          "type": "null"
        }
      ]
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      },
      "maxItems": 20
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason",
          "priority"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "required",
              "helpful"
            ]
          }
        }
      },
      "maxItems": 30
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "input",
              "vision",
              "environment",
              "knowledge",
              "fusion",
              "infrastructure"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 20
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "abnormality",
        "bbox_xywh_norm",
        "model_score",
        "score_meaning",
        "mask_ref"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "abnormality": {
          "type": "string",
          "enum": [
            "chlorosis",
            "necrotic_spot",
            "hole",
            "wilting",
            "other_visible_anomaly"
          ]
        },
        "bbox_xywh_norm": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "纠正方向后的原图 [x,y,width,height]，运行时另检 x+width<=1,y+height<=1。"
        },
        "model_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "score_meaning": {
          "const": "uncalibrated_model_score_not_disease_probability"
        },
        "mask_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^artifact://[A-Za-z0-9_./-]+$"
        }
      }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "quality_issues",
        "species_status",
        "visible_findings",
        "regions",
        "visible_leaf_area_px",
        "abnormal_area_px",
        "abnormal_area_ratio",
        "area_basis",
        "annotation_ref"
      ],
      "properties": {
        "quality": {
          "type": "string",
          "enum": [
            "usable",
            "limited",
            "unusable"
          ]
        },
        "quality_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "species_status": {
          "type": "string",
          "enum": [
            "user_declared_only",
            "visually_consistent",
            "uncertain"
          ]
        },
        "visible_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          },
          "maxItems": 50
        },
        "visible_leaf_area_px": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "abnormal_area_px": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "abnormal_area_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "area_basis": {
          "const": "union_of_abnormal_masks_intersect_visible_leaf_union_divided_by_visible_leaf_union"
        },
        "annotation_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^artifact://[A-Za-z0-9_./-]+$"
        }
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_id",
        "rule_id",
        "metric",
        "observed",
        "unit",
        "reference_range",
        "risk",
        "interpretation",
        "evidence_ids",
        "applicability_limitations"
      ],
      "properties": {
        "factor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "reference_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "elevated",
            "unknown"
          ]
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1
        },
        "applicability_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "risk_factors",
        "unassessed_metrics",
        "temporal_scope"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "analyzed",
            "missing_data",
            "no_applicable_rule",
            "error"
          ]
        },
        "risk_factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factor"
          },
          "maxItems": 30
        },
        "unassessed_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temporal_scope": {
          "const": "provided_measurements_only_not_a_time_series_trend"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_type",
        "title",
        "authors",
        "year",
        "doi",
        "url",
        "locator",
        "excerpt",
        "source_sha256",
        "applicability",
        "retrieval_score"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_type": {
          "type": "string",
          "enum": [
            "paper",
            "standard",
            "textbook",
            "agronomic_extension",
            "tcm_monograph"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1500,
          "maximum": 2100
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "species",
            "organ",
            "growth_stage",
            "evidence_role",
            "supports",
            "does_not_support"
          ],
          "properties": {
            "species": {
              "type": "string",
              "minLength": 1
            },
            "organ": {
              "type": "string",
              "minLength": 1
            },
            "growth_stage": {
              "type": "string",
              "minLength": 1
            },
            "evidence_role": {
              "type": "string",
              "enum": [
                "direct",
                "background"
              ]
            },
            "supports": {
              "type": "string",
              "minLength": 1
            },
            "does_not_support": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "retrieval_score": {
          "type": [
            "number",
            "null"
          ],
          "description": "仅用于检索排序，不是事实概率。"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "query",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "retrieved",
            "no_relevant_evidence",
            "error"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 12
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "candidate_cause",
        "support_level",
        "visual_region_ids",
        "environment_factor_ids",
        "supporting_evidence_ids",
        "conflicting_evidence_ids",
        "reasoning_summary",
        "next_verification"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "candidate_cause": {
          "type": "string",
          "minLength": 1
        },
        "support_level": {
          "type": "string",
          "enum": [
            "limited",
            "moderate",
            "strong"
          ]
        },
        "visual_region_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "environment_factor_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "supporting_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "conflicting_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "reasoning_summary": {
          "type": "string",
          "minLength": 1
        },
        "next_verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion_level",
        "summary",
        "hypotheses",
        "confirmed_pathogen",
        "medicinal_quality"
      ],
      "properties": {
        "conclusion_level": {
          "type": "string",
          "enum": [
            "symptom_observed",
            "risk_assessment",
            "insufficient_evidence"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hypothesis"
          },
          "maxItems": 5
        },
        "confirmed_pathogen": {
          "const": false
        },
        "medicinal_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "statement"
          ],
          "properties": {
            "status": {
              "const": "not_measured"
            },
            "statement": {
              "const": "本次未检测药材成分或药效，不能由叶片图像推算药效下降比例。"
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "action",
        "priority",
        "rationale",
        "evidence_ids",
        "hypothesis_ids",
        "kind"
      ],
      "properties": {
        "recommendation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "now",
            "next",
            "monitor"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "hypothesis_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "collect_more_data",
            "low_risk_observation",
            "seek_agronomic_review"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "executed_at",
        "skill_version",
        "runtime_device",
        "input_sha256",
        "corpus_version",
        "rule_version",
        "components",
        "timings_ms",
        "warnings"
      ],
      "properties": {
        "execution_mode": {
          "type": "string",
          "enum": [
            "live",
            "fixture",
            "replay"
          ]
        },
        "executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "skill_version": {
          "const": "0.1.0"
        },
        "runtime_device": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpus_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "device",
              "artifact_sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "device": {
                "type": "string",
                "minLength": 1
              },
              "artifact_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 10
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vision",
            "environment",
            "rag",
            "fusion",
            "total"
          ],
          "properties": {
            "vision": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "environment": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "rag": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "fusion": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "total": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
